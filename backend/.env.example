PORT=3000
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
JWT_EXPIRES_IN=8h
BACKUP_DIR=./database/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14

# Kosongkan DATABASE_URL untuk pakai SQLite lokal (default, dipakai saat development).
# Isi DATABASE_URL untuk pakai PostgreSQL (dipakai saat production/deploy), formatnya:
# postgresql://user:password@host:port/database
DATABASE_URL=
# Set "false" kalau provider PostgreSQL-nya tidak butuh/tidak dukung SSL (jarang terjadi)
DATABASE_SSL=true
